# Ignore compiled vcpkg-artifacts TypeScript output
/vcpkg-artifacts/**/*.js
/vcpkg-artifacts/**/*.d.ts
/vcpkg-artifacts/**/*.d.ts.map
!/vcpkg-artifacts/github-cache-cli.ts
!/vcpkg-artifacts/package.json

# Allow scripts directory package files but ignore generated content
!/scripts/package.json
!/scripts/.npmrc
!/scripts/github-cache-cli.js
